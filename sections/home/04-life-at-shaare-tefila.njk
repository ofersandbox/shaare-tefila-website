{#-
  LAYOUT for "Life at Shaare Tefila" (the photo grid on the home page).

  The photos and captions come from the section's Google Drive folder.
  build/sync-life-at.mjs reads that folder and turns this template into
  04-life-at-shaare-tefila.html. Do not type photos or text here, and do not
  edit the .html file by hand: it is replaced on every update.

  The arrangements for 3 to 8 photos are in css/style.css (search "mosaic").
-#}
<!-- Generated from the Google Drive folder "Life at Shaare Tefila" on {{ lifeAt.updated | replace("T", " ") | truncate(16, true, "") }} UTC.
     Do not edit this file: change the photos in Drive, or the layout in 04-life-at-shaare-tefila.njk. -->
  <div class="band">
    <div class="wrap">
      <h2>Life at Shaare Tefila</h2>
      <div class="mosaic mosaic--{{ lifeAt.photos | length }}">
{%- for photo in lifeAt.photos %}
        <figure class="photo"><img src="{{ photo.src }}" srcset="{{ photo.srcset }}" sizes="(max-width: 700px) 100vw, 50vw" width="{{ photo.width }}" height="{{ photo.height }}" alt="{{ photo.caption }}" loading="lazy"><figcaption>{{ photo.caption }}</figcaption></figure>
{%- endfor %}
      </div>
{%- if lifeAt.moreInFolder %}
      <p class="see-all"><a href="#gallery">See all photos</a></p>
{%- endif %}
    </div>
  </div>
